# ---------------------------------------------------------------
# Data
#
# The dataset is ~150 MB and redistributing it would breach Kaggle's
# terms. Regenerate the processed splits by running notebooks 01 and 02.
# ---------------------------------------------------------------
data/raw/*
data/processed/*
data/interim/*
!data/**/.gitkeep
!data/**/README.md
*.csv.gz
*.zip

# Keep the small saved result tables in reports/, but not scored output
reports/scored_*.csv

# ---------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------
logs/
*.log
mlruns/

# ---------------------------------------------------------------
# Secrets — never commit API keys or credentials
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
secrets.toml
.streamlit/secrets.toml

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# ---------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
